# Copier ce fichier vers .env et remplacer les exemples par vos valeurs.
# Ne jamais publier .env ni ajouter ses vrais secrets au dépôt.

# PostgreSQL Supabase — URL de connexion de l'application et URL directe des migrations.
DATABASE_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

UPSTASH_REDIS_REST_URL="https://<UPSTASH_INSTANCE>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<UPSTASH_TOKEN>"

JWT_SECRET="<GENERATE_A_LONG_RANDOM_SECRET>"
JWT_REFRESH_SECRET="<GENERATE_ANOTHER_LONG_RANDOM_SECRET>"
ADMIN_API_KEY="<GENERATE_A_LONG_RANDOM_SECRET>"
QR_SECRET="<GENERATE_A_LONG_RANDOM_SECRET>"
AES_SECRET_KEY="<32_CHARACTER_AES_KEY>"

FEDAPAY_SECRET_KEY="sk_sandbox_<KEY>"
FEDAPAY_PUBLIC_KEY="pk_sandbox_<KEY>"
FEDAPAY_WEBHOOK_SECRET="wh_sandbox_<KEY>"
FEDAPAY_ENV="sandbox"

RESEND_API_KEY="re_<KEY>"
RESEND_FROM_EMAIL="MTECHBENIN <noreply@example.com>"
ADMIN_EMAIL=""
VENDOR_WHATSAPP_NUMBER=""

PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Plusieurs boîtes IMAP au format JSON sur une ligne. Utiliser un mot de passe d'application.
IMAP_ACCOUNTS='[]'
IMAP_EMAIL=""
IMAP_PASSWORD=""
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_TEST_ONLY=false
OTP_VALIDITY_GRACE_DAYS=3

# En production VPS seulement : chemin persistant pour la session WhatsApp.
WHATSAPP_SESSION_PATH=""
