{
  "name": "mtechbenin-backend",
  "version": "1.0.0",
  "description": "Backend API MTECHBENIN — E-commerce + Abonnements",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon --ignore whatsapp-session/ src/app.js",
    "build": "prisma generate",
    "start": "prisma generate && prisma migrate deploy && node src/app.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "test": "node --test src/modules/*/*.test.js src/emails/*.test.js src/middleware/*.test.js src/services/*.test.js src/utils/*.test.js workers/*.test.js",
    "deploy:prepare": "prisma generate && prisma migrate deploy",
    "start:prod": "node src/app.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@hapi/boom": "^9.1.3",
    "@upstash/redis": "^1.31.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "fedapay": "^1.2.5",
    "helmet": "^7.1.0",
    "imapflow": "^1.4.0",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.9",
    "morgan": "^1.10.0",
    "pino": "^10.3.1",
    "prisma": "^5.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^3.4.0",
    "sucrase": "^3.35.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@react-email/ui": "^6.6.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
